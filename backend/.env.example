APP_NAME=P05 Waiting for the Shuttle API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_COOKIE_NAME=p05_access_token
CSRF_COOKIE_NAME=p05_csrf_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Set AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none for cross-site HTTPS deployments.
